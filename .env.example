# ---------------------------------------------------------------------------
# MediLens environment configuration
# Copy to .env.local (development) and fill in real values.
# NEVER commit a filled-in .env file.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# Public flag. When "true" the UI shows the DEVELOPMENT / DEMO DATA banner.
# Keep this "true" until a verified medicine database is connected.
NEXT_PUBLIC_DEMO_MODE=true

# --- Database -------------------------------------------------------------
# PostgreSQL connection string.
# Leave EMPTY to run against the bundled, clearly-marked demo dataset
# (read-only; admin write features are disabled without a database).
#
# Local options:
#   1) npx prisma dev              -> prints a local Prisma Postgres URL
#   2) docker compose up -d db     -> postgresql://medilens:medilens@localhost:5432/medilens
DATABASE_URL=

# --- Session / auth -------------------------------------------------------
# 32+ random bytes, base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Session lifetime in seconds (default 7 days).
SESSION_MAX_AGE=604800

# --- OCR provider ---------------------------------------------------------
# tesseract  -> local, no credentials, runs on the server (default)
# google     -> Google Cloud Vision (requires GOOGLE_VISION_API_KEY)
# mock       -> deterministic fixture output, tests only
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng
GOOGLE_VISION_API_KEY=

# --- AI provider ----------------------------------------------------------
# anthropic  -> Claude (requires ANTHROPIC_API_KEY)
# template   -> deterministic, non-LLM sentence builder over verified fields
#               (no credentials required; safe default)
AI_PROVIDER=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Email (password reset) -----------------------------------------------
# none    -> nothing is sent. The UI says plainly that no email was sent and
#            tells the user to contact an administrator. (default)
# dev     -> LOCAL DEVELOPMENT ONLY. Writes the message, including the reset
#            link, to ./.dev-mail/ instead of sending it. Read the newest one
#            with:  npm run dev:reset-link
#            The directory is gitignored and files are written 0600.
# resend  -> real transactional email. Requires RESEND_API_KEY. MAIL_FROM is
#            optional: left empty, mail is sent from Resend's sandbox sender
#            onboarding@resend.dev (no domain verification, but it only
#            delivers to your own Resend account email). Set MAIL_FROM to an
#            address on a verified domain to reach arbitrary recipients.
MAIL_PROVIDER=none
MAIL_FROM=
RESEND_API_KEY=
# How long a password-reset link stays valid, in minutes.
PASSWORD_RESET_TTL_MINUTES=30

# --- Translation provider -------------------------------------------------
# stored     -> use only admin-reviewed translations stored in the database
# ai         -> fall back to the AI provider for untranslated verified fields
#               (output is labelled "machine translated, unreviewed")
TRANSLATION_PROVIDER=stored

# --- Text to speech -------------------------------------------------------
# browser    -> Web Speech API in the client (no credentials, default)
# server     -> server-side TTS provider (not configured in v1)
TTS_PROVIDER=browser

# --- File storage ---------------------------------------------------------
# local      -> ./storage/local  (development only)
# s3         -> S3-compatible object storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# How long an uploaded medicine/prescription image is retained, in hours.
# Images are deleted after this window unless the user explicitly saved them.
UPLOAD_RETENTION_HOURS=24

# --- Limits ---------------------------------------------------------------
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30

# --- Admin bootstrap ------------------------------------------------------
# Used only by `npm run admin:create`.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
